{
  "name": "xlsx-audit-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.koleharv/xlsx-audit-mcp",
  "description": "MCP server that audits Excel workbooks — formula dependency tracing, circular-reference detection, and risk smells (INDIRECT, hardcoded constants, external links). Reviews the model, not the data.",
