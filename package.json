    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "excel",
    "xlsx",
    "spreadsheet",
    "formula",
    "audit",
    "dependency-tracing",
    "financial-model",
    "claude"
  ],
  "license": "MIT",
  "author": "Kole Harvey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koleharv/xlsx-audit-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^5.10.0",
    "fflate": "^0.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
